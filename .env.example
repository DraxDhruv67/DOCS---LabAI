# ==========================================
# LabOS Production Environment Configuration
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Standard or Pooled Connection String (e.g. Supabase, Neon, or VPS PostgreSQL)
# Example for Neon/Supabase pooled connection:
DATABASE_URL="postgresql://postgres:yourpassword@db-host.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Local SQLite fallback for offline development:
# DATABASE_URL="file:./dev.db"

# 2. AUTHENTICATION & SECURITY
# Strong random JWT Secret (generate via: openssl rand -base64 32)
JWT_SECRET="generate-a-strong-secret-key-for-production-jwt-auth"

# 3. AI CODE ASSISTANT (Gemini API)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 4. CLOUD FILE STORAGE (Optional - Cloudflare R2 / AWS S3 / Supabase Storage)
# If left blank, file uploads default to protected local storage on the server (/storage/uploads).
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_BUCKET="labos-assignments"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL="https://pub-<id>.r2.dev"
